<Window x:Class="Scheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Scheduler.Controls"
        xmlns:vm="clr-namespace:Scheduler.Core.ViewModels;assembly=Scheduler.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Scheduler — timeline widget"
        Width="1320"
        Height="800"
        MinWidth="1000"
        MinHeight="600"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Command="{Binding GenerateCommand}" Gesture="Ctrl+G" />
    <KeyBinding Command="{Binding TogglePlayCommand}" Gesture="Ctrl+Space" />
  </Window.InputBindings>

  <Window.Resources>
    <Style x:Key="StatusChip" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style x:Key="SidebarLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================== Sidebar ============================== -->
    <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,20,16,16">

          <StackPanel Margin="4,0,0,22" Orientation="Horizontal">
            <Image Width="38" Height="38" Source="Assets/logo.png" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="Scheduler" />
              <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="Virtualized timeline widget" />
            </StackPanel>
          </StackPanel>

          <!-- Generation -->
          <TextBlock Style="{StaticResource SidebarHeader}" Text="GENERATE" />
          <Border Style="{StaticResource SidebarSection}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource SidebarLabel}" Text="Layers" />
                  <TextBox Style="{StaticResource SidebarInputBox}" Text="{Binding LayersInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource SidebarLabel}" Text="Events" />
                  <TextBox Style="{StaticResource SidebarInputBox}" Text="{Binding EventsInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <TextBlock Margin="0,0,0,10"
                         FontSize="12"
                         Foreground="#FCA5A5"
                         Text="{Binding InputError}"
                         TextWrapping="Wrap"
                         Visibility="{Binding InputError, Converter={StaticResource VisibleWhen}}" />
              <Button HorizontalAlignment="Stretch"
                      Command="{Binding GenerateCommand}"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Generate a new random schedule (Ctrl+G). Up to 1,000,000 events.">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,8,0" Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon}" />
                  <TextBlock Text="Generate schedule" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Statuses -->
          <TextBlock Style="{StaticResource SidebarHeader}" Text="STATUSES" />
          <Border Style="{StaticResource SidebarSection}">
            <StackPanel>
              <CheckBox Margin="0,2,0,8" IsChecked="{Binding ShowPending}" Style="{StaticResource SidebarCheckBox}">
                <DockPanel Width="190">
                  <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Schedule.PendingCount, StringFormat=N0}" />
                  <Border Background="#FEF3C7" BorderBrush="#F59E0B" Style="{StaticResource StatusChip}" />
                  <TextBlock Text="Pending" />
                </DockPanel>
              </CheckBox>
              <CheckBox Margin="0,0,0,8" IsChecked="{Binding ShowJeopardy}" Style="{StaticResource SidebarCheckBox}">
                <DockPanel Width="190">
                  <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Schedule.JeopardyCount, StringFormat=N0}" />
                  <Border Background="#FEE2E2" BorderBrush="#EF4444" Style="{StaticResource StatusChip}" />
                  <TextBlock Text="Jeopardy" />
                </DockPanel>
              </CheckBox>
              <CheckBox Margin="0,0,0,2" IsChecked="{Binding ShowCompleted}" Style="{StaticResource SidebarCheckBox}">
                <DockPanel Width="190">
                  <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Schedule.CompletedCount, StringFormat=N0}" />
                  <Border Background="#D1FAE5" BorderBrush="#10B981" Style="{StaticResource StatusChip}" />
                  <TextBlock Text="Completed" />
                </DockPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <!-- View -->
          <TextBlock Style="{StaticResource SidebarHeader}" Text="VIEW" />
          <Border Style="{StaticResource SidebarSection}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="White" Text="{Binding Zoom, StringFormat='{}{0:0.00} px/min'}" />
                <TextBlock Style="{StaticResource SidebarLabel}" Text="Zoom (Ctrl+wheel)" />
              </DockPanel>
              <Slider Margin="0,4,0,14" Maximum="8" Minimum="0.05" Value="{Binding Zoom}" />

              <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="White" Text="{Binding Speed, StringFormat='{}{0:0} min/s'}" />
                <TextBlock Style="{StaticResource SidebarLabel}" Text="Playback speed" />
              </DockPanel>
              <Slider Margin="0,4,0,14" IsSnapToTickEnabled="True" Maximum="240" Minimum="1" TickFrequency="1" Value="{Binding Speed}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding TogglePlayCommand}" Style="{StaticResource SidebarButton}" ToolTip="Move the NOW line in real time (Ctrl+Space)">
                  <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,8,0" Style="{StaticResource Icon}">
                      <Path.Data>
                        <Binding Path="IsPlaying">
                          <Binding.Converter>
                            <controls:BoolToGeometryConverter False="{StaticResource Icon.Play}" True="{StaticResource Icon.Pause}" />
                          </Binding.Converter>
                        </Binding>
                      </Path.Data>
                    </Path>
                    <TextBlock Text="{Binding PlayLabel}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="OnJumpToNow" Style="{StaticResource SidebarButton}" ToolTip="Scroll to the NOW line">
                  <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,8,0" Data="{StaticResource Icon.Target}" Style="{StaticResource Icon}" />
                    <TextBlock Text="Now" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}">
                <Run Text="Now:" />
                <Run FontWeight="SemiBold" Foreground="White" Text="{Binding NowText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============================== Timeline ============================== -->
    <Grid Grid.Column="1" Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,16">
        <TextBlock VerticalAlignment="Bottom" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding GenerationText}" />
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="{Binding DateText}" />
          <TextBlock Style="{StaticResource MutedText}" Text="{Binding TotalText}" />
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <controls:TimelineView x:Name="Timeline"
                                 Now="{Binding Now, Mode=OneWay}"
                                 PixelsPerMinute="{Binding Zoom, Mode=TwoWay}"
                                 Schedule="{Binding Schedule, Mode=OneWay}"
                                 ShowCompleted="{Binding ShowCompleted, Mode=OneWay}"
                                 ShowJeopardy="{Binding ShowJeopardy, Mode=OneWay}"
                                 ShowPending="{Binding ShowPending, Mode=OneWay}" />

          <ScrollBar Grid.Column="1"
                     Maximum="{Binding ScrollableHeight, ElementName=Timeline}"
                     Orientation="Vertical"
                     ViewportSize="{Binding ViewportHeight, ElementName=Timeline}"
                     Value="{Binding VerticalOffset, ElementName=Timeline, Mode=TwoWay}" />
          <ScrollBar Grid.Row="1"
                     Maximum="{Binding ScrollableWidth, ElementName=Timeline}"
                     Orientation="Horizontal"
                     ViewportSize="{Binding ViewportWidth, ElementName=Timeline}"
                     Value="{Binding HorizontalOffset, ElementName=Timeline, Mode=TwoWay}" />

          <Border Grid.RowSpan="2"
                  Grid.ColumnSpan="2"
                  Background="#B3FFFFFF"
                  Visibility="{Binding IsGenerating, Converter={StaticResource VisibleWhen}}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding GenerationText}" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="16,6"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding RenderText}" />
        <TextBlock Margin="0,0,16,0" Style="{StaticResource MutedText}" Text="{Binding HoverText}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
