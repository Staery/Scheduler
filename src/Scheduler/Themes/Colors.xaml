<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette -->
  <Color x:Key="AccentColor">#4F46E5</Color>
  <Color x:Key="AccentHoverColor">#4338CA</Color>
  <Color x:Key="AccentPressedColor">#3730A3</Color>
  <Color x:Key="AccentSecondColor">#9333EA</Color>

  <!-- Brushes: main surface -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F9FAFB" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D5DB" />
  <SolidColorBrush x:Key="TextBrush" Color="#111827" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#374151" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
  <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />
  <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#C7D2FE" />

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
    <GradientStop Offset="1" Color="{StaticResource AccentSecondColor}" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />

  <!-- Brushes: sidebar -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#111827" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#312E81" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="#E5E7EB" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="#9CA3AF" />
  <SolidColorBrush x:Key="SidebarInputBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#374151" />

  <!-- Status colors -->
  <SolidColorBrush x:Key="PublishedBrush" Color="#047857" />
  <SolidColorBrush x:Key="PublishedSoftBrush" Color="#D1FAE5" />
  <SolidColorBrush x:Key="DraftBrush" Color="#B45309" />
  <SolidColorBrush x:Key="DraftSoftBrush" Color="#FEF3C7" />
  <SolidColorBrush x:Key="ArchivedBrush" Color="#4B5563" />
  <SolidColorBrush x:Key="ArchivedSoftBrush" Color="#E5E7EB" />

  <!-- Typography -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
